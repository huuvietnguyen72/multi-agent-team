# Chép thành .env rồi điền. KHÔNG commit file .env.
AGENT_MODE=mock               # mock | llm
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5     # model mặc định cho mọi role
LLM_EFFORT=medium             # low | medium | high (low rẻ hơn khi thử)
# MODEL_TESTER=claude-sonnet-5-5   # đặt model riêng từng role nếu muốn

# Plane (bỏ trống thì chạy dry-run, chỉ in thao tác)
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=
PLANE_BASE_URL=https://api.plane.so

RUN_MVN=0                     # 1: Tester chạy mvn test trong output/backend
