# Chép thành .env rồi điền. KHÔNG commit file .env.

# ---- Model cho từng role ----
# Cú pháp "<provider>:<model>"; provider khai báo trong providers.toml (thêm provider riêng: providers.local.toml).
# Thiếu ":<model>" thì dùng default_model của provider. MODEL=mock: cả team chạy kịch bản giả, không tốn token.
MODEL=mock                       # chạy thật: đổi thành vd claude-code:sonnet (main.py hỏi xác nhận trước khi gọi model)
# Ví dụ:
# MODEL=claude-code:sonnet                 # gói Claude Pro/Max qua `claude -p`, không cần API key
# MODEL=claude-api:claude-opus-5-5         # Claude API, cần ANTHROPIC_API_KEY
# MODEL=openai:gpt-5.6                     # OpenAI, cần OPENAI_API_KEY
# MODEL=openrouter:<vendor>/<model>        # OpenRouter, cần OPENROUTER_API_KEY
# MODEL=ollama:qwen3:8b                    # model chạy local bằng Ollama, không cần key
#
# Riêng từng role (pm, ba, backend, frontend, reviewer, tester); bị bỏ qua khi MODEL=mock:
# MODEL_PM=claude-code:claude-opus-5-5
# MODEL_BACKEND=opencode-go:glm-5.3
# MODEL_FRONTEND=opencode-go:kimi-k3.1-pro
# MODEL_REVIEWER=opencode-go:deepseek-v4.1-flash
# MODEL_TESTER=opencode-go:deepseek-v4.1-flash

# Tham số chung (tùy chọn); thiếu thì lấy `effort` / `max_tokens` của provider trong providers.toml.
# EFFORT=low                     # mức suy luận; giá trị hợp lệ tùy model (thường low | medium | high | max)
# EFFORT_BACKEND=high
# MAX_TOKENS_BACKEND=131072      # trần token đầu ra, tính cả token suy luận; role sinh nhiều code nên đặt cao

# ---- API key: tên biến khớp `api_key_env` của provider trong providers.toml; chỉ điền cái bạn dùng ----
ANTHROPIC_API_KEY=
OPENCODE_GO_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# ---- Dự án ----
# PROJECT=library                # dự án mặc định khi không truyền --project
RUN_TESTS=0                      # 1: Tester chạy [tests].command trong project.toml của dự án

# ---- Plane (bỏ trống thì chạy dry-run, chỉ in thao tác) ----
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=
PLANE_BASE_URL=https://api.plane.so
