---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	pm_plan(pm_plan)
	ba(ba)
	pm_review(pm_review)
	backend(backend)
	frontend(frontend)
	tester(tester)
	pm_accept(pm_accept)
	__end__([<p>__end__</p>]):::last
	__start__ --> pm_plan;
	ba --> pm_review;
	backend --> tester;
	frontend --> tester;
	pm_plan --> ba;
	pm_review -.-> ba;
	pm_review -.-> backend;
	pm_review -.-> frontend;
	pm_review -.-> pm_accept;
	tester -.-> backend;
	tester -.-> frontend;
	tester -.-> pm_accept;
	pm_accept --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
